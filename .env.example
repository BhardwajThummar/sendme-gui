# ============================================
# SendMe GUI - Environment Configuration
# ============================================
# Copy this file to .env for local development
# All values are optional and have sensible defaults

# ============================================
# Storage Configuration
# ============================================

# Name of the store file for user preferences
# Default: user-preferences.json
VITE_STORE_NAME=user-preferences.json

# Key used to store download path in preferences
# Default: download_path
VITE_DOWNLOAD_PATH_KEY=download_path

# ============================================
# Platform Configuration
# ============================================

# Default download path for Android devices
# Default: /sdcard/Download
VITE_ANDROID_DOWNLOAD_PATH=/sdcard/Download

# ============================================
# Logging Configuration
# ============================================

# Log level: ERROR, WARN, INFO, DEBUG
# Default: DEBUG in development, INFO in production
# VITE_LOG_LEVEL=DEBUG

# Enable timestamps in log output
# Default: true
# VITE_ENABLE_LOG_TIMESTAMP=true

# Enable log prefixes (level and context)
# Default: true
# VITE_ENABLE_LOG_PREFIX=true

# ============================================
# API Configuration
# ============================================

# Base URL for API calls (if needed)
# Default: empty string
# VITE_API_BASE_URL=

# Timeout for API calls in milliseconds
# Default: 30000 (30 seconds)
# VITE_API_TIMEOUT=30000

# Enable verbose mode for Tauri commands
# Default: false
# VITE_VERBOSE_MODE=false

# ============================================
# Development Notes
# ============================================
#
# - Environment variables must be prefixed with VITE_ to be accessible
# - Changes to .env require a dev server restart
# - Never commit .env file to version control
# - Keep .env.example up to date when adding new variables
