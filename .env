# ============================================
# SendMe GUI - Environment Configuration
# ============================================
# Local development environment settings

# ============================================
# Frontend (TypeScript/React) Configuration
# ============================================

# Storage Configuration
VITE_STORE_NAME=user-preferences.json
VITE_DOWNLOAD_PATH_KEY=download_path

# Platform Configuration
VITE_ANDROID_DOWNLOAD_PATH=/sdcard/Download

# Logging Configuration
# Uncomment to override default log level
# VITE_LOG_LEVEL=DEBUG
VITE_ENABLE_LOG_TIMESTAMP=true
VITE_ENABLE_LOG_PREFIX=true

# API Configuration
BASE_URL=https://send.hindalert.com
VITE_API_TIMEOUT=30000
VITE_VERBOSE_MODE=false

# ============================================
# Backend (Rust) Configuration
# ============================================

# Platform Configuration
ANDROID_DOWNLOAD_PATH=/sdcard/Download
ANDROID_APP_DATA_PATH=/data/data/com.sendme_gui_tauri_1.app/files
ANDROID_PACKAGE_NAME=com.sendme_gui_tauri_1.app
SDCARD_FALLBACK_PATH=/sdcard

# API Configuration
# BASE_URL is shared with frontend (defined above)
API_TIMEOUT_SECS=30

# Storage Configuration
TEMP_DIR_PREFIX=.sendme-
DOCUMENTS_FOLDER=Documents

# Network Configuration
ROUTER_SHUTDOWN_TIMEOUT_SECS=5
HTTP_TIMEOUT_SECS=30

# Logging Configuration
# Options: error, warn, info, debug, trace
RUST_LOG=info
