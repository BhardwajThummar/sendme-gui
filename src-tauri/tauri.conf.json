{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBundleCommand": "bash ./scripts/prepare-scripts.sh",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 29
    }
  },
  "productName": "sendme-gui",
  "mainBinaryName": "sendme-gui",
  "version": "0.1.4",
  "identifier": "com.sendme-gui.app",
  "plugins": {
    "dialog": null
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Secure File Transfer",
        "width": 400,
        "height": 700,
        "minWidth": 380,
        "minHeight": 640,
        "maxWidth": 420,
        "maxHeight": 800,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "useHttpsScheme": true
      }
    ]
  }
}
