{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBundleCommand": "bash ./scripts/prepare-scripts.sh",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "sendme-gui-tauri-1",
  "mainBinaryName": "sendme-gui-tauri-1",
  "version": "0.1.0",
  "identifier": "com.sendme-gui-tauri-1.app",
  "plugins": {
    "dialog": {
      "all": true
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "sendme-gui-tauri-1",
        "width": 800,
        "height": 600,
        "useHttpsScheme": true
      }
    ]
  }
}